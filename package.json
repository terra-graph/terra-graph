{
  "name": "@terra-graph/terra-graph",
  "license": "Apache-2.0",
  "author": {
    "name": "Kevin Baldwyn",
    "url": "https://github.com/terra-graph/terra-graph"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terra-graph/terra-graph.git"
  },
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "./dist/",
    "./bin/",
    "./docs/commands.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "(rm -r ./dist || true) && yarn lint && yarn build:ci",
    "build:ci": "tsc -p tsconfig.json",
    "build:nolint": "(rm -r ./dist || true) && yarn build:ci",
    "lint": "biome check --write",
    "lint:ci": "biome check",
    "oclif:readme": "oclif readme --readme-path=docs/commands.md",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test --watchAll"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@jest/types": "^30.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "graphology-types": "^0.24.8",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "oclif": "^4.17.10",
    "semantic-release": "^24.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@oclif/core": "^4.0.34",
    "@terra-graph/core": "^0.1.0"
  },
  "bin": {
    "terra-graph": "./bin/run.js"
  },
  "oclif": {
    "bin": "terra-graph",
    "commands": "./dist/commands",
    "dirname": "terra-graph",
    "topicSeparator": ":"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "rc/*",
        "prerelease": "rc"
      },
      {
        "name": "1.x",
        "range": "1.x",
        "channel": "1.x"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "access": "public"
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
